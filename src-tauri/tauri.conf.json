{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nivalis Save Editor",
  "version": "1.7.0",
  "identifier": "com.renokk.nivalis-save-editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nivalis Save Editor",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "publisher": "RenokK",
    "copyright": "Copyright (c) 2026 RenokK. CC BY-NC 4.0. Unofficial fan-made tool, not affiliated with ION LANDS.",
    "category": "Utility",
    "shortDescription": "Savegame editor for Nivalis Nights",
    "longDescription": "Unofficial savegame editor for Nivalis Nights: edit money and story variables, compare saves, with automatic backups.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
